{
  "name": "@electerm/electerm-locales",
  "version": "2.4.1",
  "description": "electerm multi-language support pack",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js"
    },
    "./esm/*": "./dist/esm/*.mjs",
    "./cjs/*": "./dist/cjs/*.js"
  },
  "scripts": {
    "lint": "standard",
    "fix": "standard --fix",
    "test": "npm run build && node --test tests/*.spec.js",
    "pre-push": "npm run lint && npm run test",
    "build": "node bin/build.js",
    "pub": "npm run build && npm publish --access public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electerm/electerm-locales.git"
  },
  "keywords": [
    "electerm",
    "locale",
    "language"
  ],
  "author": "ZHAO Xudong <zxdong@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/electerm/electerm-locales/issues"
  },
  "homepage": "https://github.com/electerm/electerm-locales#readme",
  "devDependencies": {
    "country-flag-emoji": "^1.0.3",
    "dotenv": "^16.0.3",
    "json5": "^2.2.3",
    "lodash": "^4.18.1",
    "mkdirp": "^1.0.4",
    "recursive-assign": "^0.2.0",
    "shelljs": "^0.8.5",
    "socks-proxy-agent": "^7.0.0",
    "standard": "^17.0.0"
  },
  "overrides": {
    "ajv": "^6.15.0",
    "brace-expansion": "^1.1.22",
    "cross-spawn": "^7.0.6",
    "flatted": "^3.4.4",
    "js-yaml": "^4.3.2",
    "minimatch": "^3.1.5",
    "socks": "^2.8.11",
    "word-wrap": "^1.2.5",
    "semver": "^7.8.6",
    "eslint-plugin-react": {
      "semver": "^6.3.2"
    },
    "tsconfig-paths": {
      "json5": "^1.0.2"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
